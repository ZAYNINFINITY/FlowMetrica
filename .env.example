# MATLAB Online worker queue (server-side only; never expose these to the browser).
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Optional. Default development without Upstash uses an in-memory queue.
# VERCEL builds always require the Upstash variables above.
